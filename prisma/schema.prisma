generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MemoryTemporalKind {
  point
  range
  recurring
  relative
  contextual
  unknown
}

enum MemoryTemporalPrecision {
  day
  month
  year
  academic_year
  semester
  unspecified
}

enum MemoryTemporalDerivation {
  source_explicit
  contextual_inference
  unresolved
}

/// 一次 source-semantics-full.v4 全量来源语义编译。
/// 当前导入策略会先删除这里的全部记录，再依靠级联删除清空整个来源记忆层。
model MemoryCompilation {
  id                      String   @id @default(uuid()) @db.Uuid
  schemaVersion           String   @map("schema_version") @db.Text
  compiledAt              DateTime @map("compiled_at")
  importedAt              DateTime @default(now()) @map("imported_at")
  sourcePath              String   @map("source_path") @db.Text
  sourceTitle             String   @map("source_title") @db.Text
  sourceSha256            String   @map("source_sha256") @db.Text
  sourceParser            String   @map("source_parser") @db.Text
  sourcePageCount         Int      @map("source_page_count")
  sourceBlockCount        Int      @map("source_block_count")
  regionTreeSchemaVersion String   @map("region_tree_schema_version") @db.Text
  sourceNodeIds           String[] @map("source_node_ids")
  sourceNodeCount         Int      @map("source_node_count")
  assertionCount          Int      @map("assertion_count")
  objectCount             Int      @map("object_count")
  objectMentionCount      Int      @map("object_mention_count")
  modelCalls              Int      @map("model_calls")

  sourceRegions MemorySourceRegion[]
  sourceBlocks  MemorySourceBlock[]
  objects       MemoryObject[]
  assertions    MemoryAssertion[]

  @@index([sourceSha256])
  @@map("memory_compilations")
}

/// 区域树中实际拥有原文并经过 source semantics 编译的节点。
model MemorySourceRegion {
  id                  String   @id @default(uuid()) @db.Uuid
  compilationId       String   @map("compilation_id") @db.Uuid
  sourceNodeId        String   @map("source_node_id") @db.Text
  schemaVersion       String   @map("schema_version") @db.Text
  label               String   @db.Text
  lineageNodeIds      String[] @map("lineage_node_ids")
  sourcePages         Int[]    @map("source_pages")
  sourceBlockIds      String[] @map("source_block_ids")
  coveredBlockIds     String[] @map("covered_block_ids")
  unclaimedBlockIds   String[] @map("unclaimed_block_ids")
  initialClaimCount   Int      @map("initial_claim_count")
  reviewAdditionCount Int      @map("review_addition_count")
  modelCalls          Int      @map("model_calls")
  createdAt           DateTime @map("created_at")

  compilation MemoryCompilation     @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  objects     MemoryObject[]
  assertions  MemoryAssertion[]
  mentions    MemoryObjectMention[]

  @@unique([compilationId, sourceNodeId])
  @@index([label])
  @@map("memory_source_regions")
}

/// PDF 解析后的稳定原文块，是 Assertion 的来源依据和回看锚点。
model MemorySourceBlock {
  id            String   @id @default(uuid()) @db.Uuid
  compilationId String   @map("compilation_id") @db.Uuid
  sourceBlockId String   @map("source_block_id") @db.Text
  order         Int
  blockType     String   @map("block_type") @db.Text
  sourcePages   Int[]    @map("source_pages")
  headingLevel  Int?     @map("heading_level")
  headingPath   String[] @map("heading_path")
  sourceType    String?  @map("source_type") @db.Text
  sourceSubType String?  @map("source_sub_type") @db.Text
  bbox          Json?    @db.JsonB
  assetPath     String?  @map("asset_path") @db.Text
  markdown      String   @db.Text

  compilation   MemoryCompilation            @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  assertionUses MemoryAssertionSourceBlock[]

  @@unique([compilationId, sourceBlockId])
  @@unique([compilationId, order])
  @@map("memory_source_blocks")
}

/// 当前来源区域中由字面 mention 确定性生成的 provisional Object。
model MemoryObject {
  id             String   @id @default(uuid()) @db.Uuid
  compilationId  String   @map("compilation_id") @db.Uuid
  sourceRegionId String   @map("source_region_id") @db.Uuid
  sourceObjectId String   @map("source_object_id") @db.Text
  label          String   @db.Text
  aliases        String[]
  createdAt      DateTime @default(now()) @map("created_at")

  compilation  MemoryCompilation     @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  sourceRegion MemorySourceRegion    @relation(fields: [sourceRegionId], references: [id], onDelete: Cascade)
  mentions     MemoryObjectMention[]

  @@unique([sourceRegionId, sourceObjectId])
  @@index([compilationId, label])
  @@map("memory_objects")
}

/// 来源关于一个或多个 Object 作出的冻结原子命题。
model MemoryAssertion {
  id                        String   @id @default(uuid()) @db.Uuid
  compilationId             String   @map("compilation_id") @db.Uuid
  sourceRegionId            String   @map("source_region_id") @db.Uuid
  sourceClaimId             String   @map("source_claim_id") @db.Text
  statementTemplateMarkdown String   @map("statement_template_markdown") @db.Text
  createdAt                 DateTime @default(now()) @map("created_at")

  compilation         MemoryCompilation            @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  sourceRegion        MemorySourceRegion           @relation(fields: [sourceRegionId], references: [id], onDelete: Cascade)
  mentions            MemoryObjectMention[]
  sourceBlockLinks    MemoryAssertionSourceBlock[]
  temporalAnnotations MemoryTemporalAnnotation[]

  @@unique([sourceRegionId, sourceClaimId])
  @@map("memory_assertions")
}

/// Object 在冻结命题中的精确、可逆字面位置。
model MemoryObjectMention {
  id              String @id @default(uuid()) @db.Uuid
  sourceRegionId  String @map("source_region_id") @db.Uuid
  assertionId     String @map("assertion_id") @db.Uuid
  objectId        String @map("object_id") @db.Uuid
  sourceMentionId String @map("source_mention_id") @db.Text
  spanText        String @map("span_text") @db.Text
  occurrenceIndex Int    @map("occurrence_index")
  start           Int
  end             Int

  sourceRegion MemorySourceRegion @relation(fields: [sourceRegionId], references: [id], onDelete: Cascade)
  assertion    MemoryAssertion    @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  object       MemoryObject       @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([sourceRegionId, sourceMentionId])
  @@index([assertionId])
  @@index([objectId])
  @@map("memory_object_mentions")
}

/// Assertion 对稳定原文块的直接依据；ordinal 保留 supporting_block_ids 顺序。
model MemoryAssertionSourceBlock {
  assertionId String @map("assertion_id") @db.Uuid
  blockId     String @map("block_id") @db.Uuid
  ordinal     Int

  assertion   MemoryAssertion   @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  sourceBlock MemorySourceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([assertionId, blockId])
  @@index([blockId])
  @@map("memory_assertion_source_blocks")
}

/// Assertion 中一项来源锚定的结构化时间表达，不表示事实真实性或当前有效性。
model MemoryTemporalAnnotation {
  id             String                   @id @default(uuid()) @db.Uuid
  assertionId    String                   @map("assertion_id") @db.Uuid
  ordinal        Int
  rawExpression  String                   @map("raw_expression") @db.Text
  kind           MemoryTemporalKind
  normalizedText String                   @map("normalized_text") @db.Text
  start          String?                  @db.Text
  end            String?                  @db.Text
  precision      MemoryTemporalPrecision
  derivation     MemoryTemporalDerivation
  basisMarkdown  String                   @map("basis_markdown") @db.Text

  assertion MemoryAssertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)

  @@unique([assertionId, ordinal])
  @@index([kind, precision])
  @@map("memory_temporal_annotations")
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MemoryAssertionKind {
  grounded
  reference
}

enum SemanticCardProposalStatus {
  pending
  approved
  rejected
  applied
  failed
}

enum MemoryChatAssertionReceiptStatus {
  queued
  running
  published
  skipped
  failed
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum MemoryAmbientHigherMemoryScope {
  workspace
  recent
}

enum LibraryNodeKind {
  file
  folder
}

enum LibraryProcessingProfile {
  catalog
  coarse
  deep
}

enum LibraryProcessingStatus {
  idle
  queued
  running
  ready
  failed
}

enum LibraryPlanStatus {
  pending
  approved
  rejected
  applied
  failed
}

enum LibraryCompilationJobStatus {
  queued
  running
  paused
  completed
  failed
}

enum LibraryProcessingStage {
  queued
  preparing
  parsing
  analyzing
  resolving
  staging
  ready
  failed
}

/// 一次本地目录或后续上传批次。第一版只记录导入结果，不承担文件同步。
model LibraryImportBatch {
  id              String    @id @default(uuid()) @db.Uuid
  displayName     String    @map("display_name") @db.Text
  originalRoot    String?   @map("original_root") @db.Text
  status          String    @default("running") @db.Text
  fileCount       Int       @default(0) @map("file_count")
  uniqueBlobCount Int       @default(0) @map("unique_blob_count")
  errorMessage    String?   @map("error_message") @db.Text
  importedAt      DateTime  @default(now()) @map("imported_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)

  nodes LibraryNode[]

  @@map("library_import_batches")
}

/// 按 SHA-256 保存的不可变原件；多个目录位置可以共享同一个 Blob。
model LibrarySourceBlob {
  id         String   @id @default(uuid()) @db.Uuid
  sha256     String   @unique @db.Text
  storageKey String   @map("storage_key") @db.Text
  mimeType   String   @map("mime_type") @db.Text
  byteSize   BigInt   @map("byte_size")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  nodes              LibraryNode[]
  processingRuns     LibrarySourceProcessingRun[]
  catalogAssessments LibraryCatalogAssessment[]

  @@map("library_source_blobs")
}

/// Echo 资料库中的虚拟文件或文件夹。移动和重命名只改变树位置，不改变 Blob 或来源身份。
model LibraryNode {
  id                   String                   @id @default(uuid()) @db.Uuid
  kind                 LibraryNodeKind
  parentId             String?                  @map("parent_id") @db.Uuid
  name                 String                   @db.Text
  normalizedName       String                   @map("normalized_name") @db.Text
  blobId               String?                  @map("blob_id") @db.Uuid
  importBatchId        String?                  @map("import_batch_id") @db.Uuid
  originalRelativePath String?                  @map("original_relative_path") @db.Text
  processingProfile    LibraryProcessingProfile @default(catalog) @map("processing_profile")
  processingStatus     LibraryProcessingStatus  @default(idle) @map("processing_status")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent             LibraryNode?                 @relation("LibraryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           LibraryNode[]                @relation("LibraryTree")
  blob               LibrarySourceBlob?           @relation(fields: [blobId], references: [id], onDelete: Restrict)
  importBatch        LibraryImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  processingRuns     LibrarySourceProcessingRun[]
  catalogAssessments LibraryCatalogAssessment[]

  @@unique([parentId, normalizedName])
  @@index([parentId, kind, name])
  @@index([blobId])
  @@index([processingProfile, processingStatus])
  @@map("library_nodes")
}

/// 一次可恢复的基础编译任务。任务对唯一 Blob 去重，固定按 deep→coarse→catalog 执行。
model LibraryCompilationJob {
  id                  String                      @id @default(uuid()) @db.Uuid
  status              LibraryCompilationJobStatus @default(queued)
  activePhase         LibraryProcessingProfile?   @map("active_phase")
  pauseRequested      Boolean                     @default(false) @map("pause_requested")
  totalContent        Int                         @default(0) @map("total_content")
  completedContent    Int                         @default(0) @map("completed_content")
  failedContent       Int                         @default(0) @map("failed_content")
  deepTotal           Int                         @default(0) @map("deep_total")
  deepCompleted       Int                         @default(0) @map("deep_completed")
  coarseTotal         Int                         @default(0) @map("coarse_total")
  coarseCompleted     Int                         @default(0) @map("coarse_completed")
  catalogTotal        Int                         @default(0) @map("catalog_total")
  catalogCompleted    Int                         @default(0) @map("catalog_completed")
  configuration       Json                        @default("{}") @db.JsonB
  activeStage         String?                     @map("active_stage") @db.Text
  globalStatus        String                      @default("queued") @map("global_status") @db.Text
  globalProgress      Int                         @default(0) @map("global_progress")
  globalTotal         Int                         @default(0) @map("global_total")
  globalRetryCount    Int                         @default(0) @map("global_retry_count")
  globalStatusMessage String?                     @map("global_status_message") @db.Text
  globalErrorMessage  String?                     @map("global_error_message") @db.Text
  globalCheckpoint    Json                        @default("{}") @map("global_checkpoint") @db.JsonB
  globalResult        Json                        @default("{}") @map("global_result") @db.JsonB
  errorMessage        String?                     @map("error_message") @db.Text
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt           DateTime?                   @map("started_at") @db.Timestamptz(3)
  heartbeatAt         DateTime?                   @map("heartbeat_at") @db.Timestamptz(3)
  completedAt         DateTime?                   @map("completed_at") @db.Timestamptz(3)

  runs LibrarySourceProcessingRun[]

  @@index([status, createdAt])
  @@map("library_compilation_jobs")
}

/// 资料库当前生效的跨文件 Object 草稿快照。重编译只在成功后原子替换它。
model LibraryCompilationState {
  id            String   @id @default("default") @db.Text
  globalObjects Json     @default("[]") @map("global_objects") @db.JsonB
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("library_compilation_state")
}

/// 解析或编译的一次运行记录。成功运行会在 Global Object 归并后发布到 Shared Brain。
model LibrarySourceProcessingRun {
  id                      String                   @id @default(uuid()) @db.Uuid
  libraryNodeId           String                   @map("library_node_id") @db.Uuid
  sourceBlobId            String?                  @map("source_blob_id") @db.Uuid
  jobId                   String?                  @map("job_id") @db.Uuid
  profile                 LibraryProcessingProfile
  profileVersion          String                   @map("profile_version") @db.Text
  status                  LibraryProcessingStatus  @default(queued)
  stage                   LibraryProcessingStage   @default(queued)
  phaseOrder              Int                      @default(0) @map("phase_order")
  progressCurrent         Int                      @default(0) @map("progress_current")
  progressTotal           Int                      @default(1) @map("progress_total")
  statusMessage           String?                  @map("status_message") @db.Text
  retryCount              Int                      @default(0) @map("retry_count")
  isCurrent               Boolean                  @default(false) @map("is_current")
  checkpoint              Json                     @default("{}") @db.JsonB
  parserKey               String?                  @map("parser_key") @db.Text
  artifactLocation        String?                  @map("artifact_location") @db.Text
  resultSummary           String?                  @map("result_summary") @db.Text
  errorMessage            String?                  @map("error_message") @db.Text
  publishedAt             DateTime?                @map("published_at") @db.Timestamptz(3)
  publishedAssertionCount Int                      @default(0) @map("published_assertion_count")
  publishedObjectCount    Int                      @default(0) @map("published_object_count")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt             DateTime?                @map("completed_at") @db.Timestamptz(3)

  libraryNode LibraryNode               @relation(fields: [libraryNodeId], references: [id], onDelete: Cascade)
  sourceBlob  LibrarySourceBlob?        @relation(fields: [sourceBlobId], references: [id], onDelete: Restrict)
  job         LibraryCompilationJob?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  document    LibrarySourceDocument?
  assessment  LibraryCatalogAssessment?

  @@unique([jobId, sourceBlobId])
  @@index([libraryNodeId, createdAt])
  @@index([status, createdAt])
  @@index([jobId, phaseOrder, status])
  @@index([sourceBlobId, isCurrent])
  @@map("library_source_processing_runs")
}

/// 轻量编目或粗编译的带来源候选；Global Object 归并成功后会发布为 Shared Brain Assertion。
model LibraryCatalogAssessment {
  id                   String   @id @default(uuid()) @db.Uuid
  processingRunId      String   @unique @map("processing_run_id") @db.Uuid
  sourceBlobId         String   @map("source_blob_id") @db.Uuid
  representativeNodeId String   @map("representative_node_id") @db.Uuid
  summary              String   @db.Text
  previewExcerpt       String?  @map("preview_excerpt") @db.Text
  referenceCandidates  Json     @default("[]") @map("reference_candidates") @db.JsonB
  assertionCandidates  Json     @default("[]") @map("assertion_candidates") @db.JsonB
  objectCandidates     Json     @default("[]") @map("object_candidates") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  processingRun      LibrarySourceProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)
  sourceBlob         LibrarySourceBlob          @relation(fields: [sourceBlobId], references: [id], onDelete: Restrict)
  representativeNode LibraryNode                @relation(fields: [representativeNodeId], references: [id], onDelete: Cascade)

  @@index([sourceBlobId])
  @@map("library_catalog_assessments")
}

/// 经过解析的资料库文档骨架；后续 SourceBlock 迁移后将直接挂到这里。
model LibrarySourceDocument {
  id                String   @id @default(uuid()) @db.Uuid
  processingRunId   String   @unique @map("processing_run_id") @db.Uuid
  title             String   @db.Text
  parser            String   @db.Text
  structureMetadata Json     @default("{}") @map("structure_metadata") @db.JsonB
  blockCount        Int      @default(0) @map("block_count")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  processingRun LibrarySourceProcessingRun @relation(fields: [processingRunId], references: [id], onDelete: Cascade)

  @@map("library_source_documents")
}

/// AI 对资料库移动与处理档位的轻量建议；批准前不改变文件树。
model LibraryPlan {
  id            String            @id @default(uuid()) @db.Uuid
  status        LibraryPlanStatus @default(pending)
  reason        String            @db.Text
  operations    Json              @db.JsonB
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz(3)
  appliedAt     DateTime?         @map("applied_at") @db.Timestamptz(3)
  failureReason String?           @map("failure_reason") @db.Text

  @@index([status, createdAt])
  @@map("library_plans")
}

/// Echo 当前 Shared Brain 快照。cold-start、粗编译、轻量编目和对话 Assertion 共用同一个活跃 Compilation。
model MemoryCompilation {
  id                           String   @id @default(uuid()) @db.Uuid
  schemaVersion                String   @map("schema_version") @db.Text
  compiledAt                   DateTime @map("compiled_at")
  importedAt                   DateTime @default(now()) @map("imported_at")
  sourcePath                   String   @map("source_path") @db.Text
  sourceTitle                  String   @map("source_title") @db.Text
  sourceSha256                 String   @map("source_sha256") @db.Text
  sourceParser                 String   @map("source_parser") @db.Text
  sourcePageCount              Int      @map("source_page_count")
  sourceBlockCount             Int      @map("source_block_count")
  /// 来源自身明确提供的时间锚点；不是其中全部 Assertion 的 validity。
  sourceTimeText               String?  @map("source_time_text") @db.Text
  sourceTimeSupportingBlockIds String[] @default([]) @map("source_time_supporting_block_ids")
  regionTreeSchemaVersion      String   @map("region_tree_schema_version") @db.Text
  sourceNodeIds                String[] @map("source_node_ids")
  sourceNodeCount              Int      @map("source_node_count")
  assertionCount               Int      @map("assertion_count")
  objectFragmentCount          Int      @map("object_fragment_count")
  surfaceFormCount             Int      @map("surface_form_count")
  fragmentReferenceCount       Int      @map("fragment_reference_count")
  modelCalls                   Int      @map("model_calls")

  sourceRegions           MemorySourceRegion[]
  sourceBlocks            MemorySourceBlock[]
  objectFragments         MemorySourceObjectFragment[]
  assertions              MemoryAssertion[]
  chatEvidence            MemoryChatEvidence[]
  chatAssertionCaptures   MemoryChatAssertionCapture[]
  chatAssertionReceipts   MemoryChatAssertionReceipt[]
  objectHigherMemories    MemoryObjectHigherMemory[]
  globalObjects           MemoryGlobalObject[]
  assertionEmbeddingIndex MemoryAssertionEmbeddingIndex?
  semanticCards           SemanticCard[]
  semanticCardProposals   SemanticCardProposal[]
  objectChangeProposals   MemoryObjectChangeProposal[]

  @@index([sourceSha256])
  @@map("memory_compilations")
}

/// 区域树中实际拥有原文并经过 source semantics 编译的节点。
model MemorySourceRegion {
  id                  String   @id @default(uuid()) @db.Uuid
  compilationId       String   @map("compilation_id") @db.Uuid
  sourceNodeId        String   @map("source_node_id") @db.Text
  schemaVersion       String   @map("schema_version") @db.Text
  label               String   @db.Text
  lineageNodeIds      String[] @map("lineage_node_ids")
  sourcePages         Int[]    @map("source_pages")
  sourceBlockIds      String[] @map("source_block_ids")
  coveredBlockIds     String[] @map("covered_block_ids")
  unclaimedBlockIds   String[] @map("unclaimed_block_ids")
  initialClaimCount   Int      @map("initial_claim_count")
  reviewAdditionCount Int      @map("review_addition_count")
  modelCalls          Int      @map("model_calls")
  createdAt           DateTime @map("created_at")
  /// 多文件 Shared Brain 中的真实来源元数据；历史单文档 Compilation 可为 null。
  sourcePath          String?  @map("source_path") @db.Text
  sourceTitle         String?  @map("source_title") @db.Text
  sourceSha256        String?  @map("source_sha256") @db.Text
  sourceParser        String?  @map("source_parser") @db.Text

  compilation     MemoryCompilation            @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  objectFragments MemorySourceObjectFragment[]
  assertions      MemoryAssertion[]

  @@unique([compilationId, sourceNodeId])
  @@index([label])
  @@index([sourceSha256])
  @@map("memory_source_regions")
}

/// PDF 解析后的稳定原文块，是 Assertion 的来源依据和回看锚点。
model MemorySourceBlock {
  id            String   @id @default(uuid()) @db.Uuid
  compilationId String   @map("compilation_id") @db.Uuid
  sourceBlockId String   @map("source_block_id") @db.Text
  order         Int
  blockType     String   @map("block_type") @db.Text
  sourcePages   Int[]    @map("source_pages")
  headingLevel  Int?     @map("heading_level")
  headingPath   String[] @map("heading_path")
  sourceType    String?  @map("source_type") @db.Text
  sourceSubType String?  @map("source_sub_type") @db.Text
  bbox          Json?    @db.JsonB
  assetPath     String?  @map("asset_path") @db.Text
  markdown      String   @db.Text

  compilation   MemoryCompilation            @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  assertionUses MemoryAssertionSourceBlock[]

  @@unique([compilationId, sourceBlockId])
  @@unique([compilationId, order])
  @@map("memory_source_blocks")
}

/// Leaf compiler 产生的 source-local ObjectFragment；不是长期 Object，也不直接供 Search 使用。
model MemorySourceObjectFragment {
  id               String   @id @default(uuid()) @db.Uuid
  compilationId    String   @map("compilation_id") @db.Uuid
  sourceRegionId   String   @map("source_region_id") @db.Uuid
  sourceFragmentId String   @map("source_fragment_id") @db.Text
  surfaceForms     String[] @map("surface_forms")
  createdAt        DateTime @default(now()) @map("created_at")

  compilation         MemoryCompilation                     @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  sourceRegion        MemorySourceRegion                    @relation(fields: [sourceRegionId], references: [id], onDelete: Cascade)
  assertionReferences MemoryAssertionFragmentReference[]
  surfaceMemberships  MemoryGlobalObjectSurfaceMembership[]

  @@unique([sourceRegionId, sourceFragmentId])
  @@index([compilationId])
  @@map("memory_source_object_fragments")
}

/// 来源中的内聚知识单元，或指向明确来源区域的导航索引。
model MemoryAssertion {
  id                              String              @id @default(uuid()) @db.Uuid
  compilationId                   String              @map("compilation_id") @db.Uuid
  sourceRegionId                  String?             @map("source_region_id") @db.Uuid
  chatCaptureId                   String?             @map("chat_capture_id") @db.Uuid
  sourceClaimId                   String              @map("source_claim_id") @db.Text
  kind                            MemoryAssertionKind @default(grounded)
  statementTemplateMarkdown       String              @map("statement_template_markdown") @db.Text
  globalStatementTemplateMarkdown String              @map("global_statement_template_markdown") @db.Text
  contextDependent                Boolean             @map("context_dependent")
  createdAt                       DateTime            @default(now()) @map("created_at")

  compilation              MemoryCompilation                       @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  sourceRegion             MemorySourceRegion?                     @relation(fields: [sourceRegionId], references: [id], onDelete: Cascade)
  chatCapture              MemoryChatAssertionCapture?             @relation(fields: [chatCaptureId], references: [id], onDelete: Cascade)
  chatEvidenceLinks        MemoryAssertionChatEvidenceLink[]
  fragmentReferences       MemoryAssertionFragmentReference[]
  literalGlobalReferences  MemoryGlobalAssertionLiteralReference[]
  semanticObjectLinks      MemoryAssertionSemanticObjectLink[]
  sourceBlockLinks         MemoryAssertionSourceBlock[]
  embedding                MemoryAssertionEmbedding?
  contentDimensionSupports SemanticContentDimensionSupport[]
  slotBindingSupports      SemanticSlotBindingSupport[]

  @@unique([sourceRegionId, sourceClaimId])
  @@unique([chatCaptureId, sourceClaimId])
  @@index([chatCaptureId])
  @@map("memory_assertions")
}

/// 一次由主回答模型显式排队、并在回答后执行的 Assertion 提取事务。
/// 完整主对话语义转录属于解释上下文，不是事实 Evidence。
model MemoryChatAssertionCapture {
  id                String   @id @default(uuid()) @db.Uuid
  compilationId     String   @map("compilation_id") @db.Uuid
  queuedByActorId   String   @map("queued_by_actor_id") @db.Uuid
  queuedByMessageId String   @map("queued_by_message_id") @db.Text
  queueReason       String   @map("queue_reason") @db.Text
  submittedAt       DateTime @map("submitted_at") @db.Timestamptz(3)
  timezone          String   @db.Text
  semanticContext   Json     @map("semantic_context") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  compilation MemoryCompilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  queuedBy    MemoryActor       @relation(fields: [queuedByActorId], references: [id], onDelete: Restrict)
  assertions  MemoryAssertion[]

  @@unique([queuedByActorId, queuedByMessageId])
  @@index([compilationId, submittedAt])
  @@map("memory_chat_assertion_captures")
}

/// Chat → Assertion 的操作回执；供后续主对话读取真实处理状态，不属于组织事实或 Evidence。
/// Capture 只在成功发布时存在，而回执也会保留 queued/running/skipped/failed 结果。
model MemoryChatAssertionReceipt {
  id                    String                           @id @default(uuid()) @db.Uuid
  compilationId         String                           @map("compilation_id") @db.Uuid
  actorId               String                           @map("actor_id") @db.Uuid
  clientMessageId       String                           @map("client_message_id") @db.Text
  execution             String                           @db.Text
  queueReason           String                           @map("queue_reason") @db.Text
  status                MemoryChatAssertionReceiptStatus @default(queued)
  submittedAt           DateTime                         @map("submitted_at") @db.Timestamptz(3)
  startedAt             DateTime?                        @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime?                        @map("completed_at") @db.Timestamptz(3)
  publishedAssertions   Int                              @default(0) @map("published_assertions")
  publishedAssertionIds String[]                         @default([]) @map("published_assertion_ids")
  affectedObjectIds     String[]                         @default([]) @map("affected_object_ids")
  affectedObjects       Json                             @default("[]") @map("affected_objects") @db.JsonB
  outcomeSummary        String?                          @map("outcome_summary") @db.Text
  errorMessage          String?                          @map("error_message") @db.Text
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)

  compilation MemoryCompilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  actor       MemoryActor       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([actorId, clientMessageId])
  @@index([compilationId, submittedAt])
  @@index([actorId, updatedAt])
  @@map("memory_chat_assertion_receipts")
}

/// 被至少一条已发布 Assertion 使用的用户聊天 Evidence；Assistant 上下文只用于解释，不是事实依据。
model MemoryChatEvidence {
  id                 String   @id @default(uuid()) @db.Uuid
  compilationId      String   @map("compilation_id") @db.Uuid
  clientMessageId    String   @map("client_message_id") @db.Text
  submittedByActorId String   @map("submitted_by_actor_id") @db.Uuid
  submittedAt        DateTime @map("submitted_at") @db.Timestamptz(3)
  timezone           String   @db.Text
  rawUserMessage     String   @map("raw_user_message") @db.Text
  submittedAtBasis   String   @default("server_received") @map("submitted_at_basis") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  compilation    MemoryCompilation                 @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  submittedBy    MemoryActor                       @relation(fields: [submittedByActorId], references: [id], onDelete: Restrict)
  assertionLinks MemoryAssertionChatEvidenceLink[]
  objectMentions MemoryChatObjectMention[]

  @@unique([submittedByActorId, clientMessageId])
  @@index([compilationId, submittedAt])
  @@map("memory_chat_evidence")
}

/// 一条 Assertion 可以由多条用户消息共同支持；逐字引文记录在关联上。
model MemoryAssertionChatEvidenceLink {
  assertionId    String   @map("assertion_id") @db.Uuid
  chatEvidenceId String   @map("chat_evidence_id") @db.Uuid
  ordinal        Int
  evidenceQuotes String[] @map("evidence_quotes")

  assertion    MemoryAssertion    @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  chatEvidence MemoryChatEvidence @relation(fields: [chatEvidenceId], references: [id], onDelete: Restrict)

  @@id([assertionId, chatEvidenceId])
  @@unique([assertionId, ordinal])
  @@index([chatEvidenceId])
  @@map("memory_assertion_chat_evidence_links")
}

/// 第一版由服务端解析出的稳定 Actor identity；认证产品以后只需替换 Actor 获取方式。
model MemoryActor {
  id          String   @id @db.Uuid
  displayName String   @map("display_name") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chatEvidence          MemoryChatEvidence[]
  chatAssertionCaptures MemoryChatAssertionCapture[]
  chatAssertionReceipts MemoryChatAssertionReceipt[]
  chatConversations     ChatConversation[]

  @@map("memory_actors")
}

/// 第一版每个 Actor 只有一个默认对话；后续可在不改变 Message 协议的前提下扩展标题、列表与归档。
model ChatConversation {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @unique @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor    MemoryActor   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_conversations")
}

/// 持久化浏览器实际展示的完整 AI SDK UIMessage parts，而不是只保存最终纯文本。
model ChatMessage {
  id              String          @id @default(uuid()) @db.Uuid
  conversationId  String          @map("conversation_id") @db.Uuid
  clientMessageId String          @map("client_message_id") @db.Text
  role            ChatMessageRole
  parts           Json
  position        Int
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, position, createdAt])
  @@map("chat_messages")
}

/// Assertion template 中一次 `{{fragment:...}}` 引用；ordinal 保留重复引用及出现顺序。
model MemoryAssertionFragmentReference {
  assertionId      String @map("assertion_id") @db.Uuid
  objectFragmentId String @map("object_fragment_id") @db.Uuid
  ordinal          Int

  assertion         MemoryAssertion                            @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  objectFragment    MemorySourceObjectFragment                 @relation(fields: [objectFragmentId], references: [id], onDelete: Cascade)
  globalResolutions MemoryGlobalAssertionReferenceResolution[]

  @@id([assertionId, ordinal])
  @@index([objectFragmentId])
  @@map("memory_assertion_fragment_references")
}

/// Assertion 对稳定原文块的直接依据；ordinal 保留 supporting_block_ids 顺序。
model MemoryAssertionSourceBlock {
  assertionId String @map("assertion_id") @db.Uuid
  blockId     String @map("block_id") @db.Uuid
  ordinal     Int

  assertion   MemoryAssertion   @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  sourceBlock MemorySourceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@id([assertionId, blockId])
  @@index([blockId])
  @@map("memory_assertion_source_blocks")
}

/// 完整 cold-start package 最终导入的 Global Object；Resolver runtime 不读写数据库。
model MemoryGlobalObject {
  id              String @id @default(uuid()) @db.Uuid
  compilationId   String @map("compilation_id") @db.Uuid
  globalObjectKey String @map("global_object_key") @db.Text
  canonicalName   String @map("canonical_name") @db.Text

  compilation            MemoryCompilation                          @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  surfaceMemberships     MemoryGlobalObjectSurfaceMembership[]
  chatMentions           MemoryChatObjectMention[]
  referenceResolutions   MemoryGlobalAssertionReferenceResolution[]
  literalReferences      MemoryGlobalAssertionLiteralReference[]
  semanticAssertionLinks MemoryAssertionSemanticObjectLink[]
  higherMemory           MemoryObjectHigherMemory?
  semanticCards          SemanticCard[]

  @@unique([compilationId, globalObjectKey])
  @@index([compilationId])
  @@map("memory_global_objects")
}

/// 对话 Evidence 中逐字出现、并被成功 Assertion 使用的 GlobalObject 名称。
/// 它让聊天创建的 Object 保留可读来源，也让后续检索能够命中用户使用过的名称或简称。
model MemoryChatObjectMention {
  globalObjectId        String   @map("global_object_id") @db.Uuid
  chatEvidenceId        String   @map("chat_evidence_id") @db.Uuid
  ordinal               Int
  surfaceForm           String   @map("surface_form") @db.Text
  normalizedSurfaceForm String   @map("normalized_surface_form") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  globalObject MemoryGlobalObject @relation(fields: [globalObjectId], references: [id], onDelete: Cascade)
  chatEvidence MemoryChatEvidence @relation(fields: [chatEvidenceId], references: [id], onDelete: Restrict)

  @@id([globalObjectId, chatEvidenceId, ordinal])
  @@unique([chatEvidenceId, ordinal])
  @@unique([globalObjectId, chatEvidenceId, surfaceForm])
  @@index([globalObjectId])
  @@index([chatEvidenceId])
  @@index([normalizedSurfaceForm])
  @@map("memory_chat_object_mentions")
}

/// 只为对话中少数重要 GlobalObject 按需维护的高优先级认知文档。
/// 它基于 Assertion 和完整对话生成，但不持久化 Assertion 索引或逐句来源绑定。
model MemoryObjectHigherMemory {
  id                String   @id @default(uuid()) @db.Uuid
  compilationId     String   @map("compilation_id") @db.Uuid
  globalObjectId    String   @unique @map("global_object_id") @db.Uuid
  contentMarkdown   String   @map("content_markdown") @db.Text
  maintainedAt      DateTime @map("maintained_at") @db.Timestamptz(3)
  triggerMessageId  String   @map("trigger_message_id") @db.Text
  maintenanceReason String   @map("maintenance_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compilation  MemoryCompilation  @relation(fields: [compilationId], references: [id], onDelete: Cascade)
  globalObject MemoryGlobalObject @relation(fields: [globalObjectId], references: [id], onDelete: Cascade)

  @@index([compilationId, maintainedAt])
  @@map("memory_object_higher_memories")
}

/// Echo 对当前工作环境与近期焦点的高层认知；每轮对话自动读取，但不是精确业务状态的权威来源。
/// 它不绑定 Compilation 或 GlobalObject，因此来源重编译不会使 Echo 丧失已从真实互动中形成的环境理解。
model MemoryAmbientHigherMemory {
  id                String                         @id @default(uuid()) @db.Uuid
  scope             MemoryAmbientHigherMemoryScope @unique
  contentMarkdown   String                         @map("content_markdown") @db.Text
  maintainedAt      DateTime                       @map("maintained_at") @db.Timestamptz(3)
  triggerMessageId  String                         @map("trigger_message_id") @db.Text
  maintenanceReason String                         @map("maintenance_reason") @db.Text
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([maintainedAt])
  @@map("memory_ambient_higher_memories")
}

/// Reference Assertion 对 Global Object 的语义覆盖；不要求 Object 名称出现在 Assertion 正文中。
model MemoryAssertionSemanticObjectLink {
  assertionId    String @map("assertion_id") @db.Uuid
  globalObjectId String @map("global_object_id") @db.Uuid

  assertion    MemoryAssertion    @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  globalObject MemoryGlobalObject @relation(fields: [globalObjectId], references: [id], onDelete: Restrict)

  @@id([assertionId, globalObjectId])
  @@index([globalObjectId])
  @@map("memory_assertion_semantic_object_links")
}

/// 一个 source-local surface form 当前归属哪个 Global Object。
model MemoryGlobalObjectSurfaceMembership {
  objectFragmentId   String @map("object_fragment_id") @db.Uuid
  surfaceFormOrdinal Int    @map("surface_form_ordinal")
  globalObjectId     String @map("global_object_id") @db.Uuid

  objectFragment MemorySourceObjectFragment @relation(fields: [objectFragmentId], references: [id], onDelete: Cascade)
  globalObject   MemoryGlobalObject         @relation(fields: [globalObjectId], references: [id], onDelete: Restrict)

  @@id([objectFragmentId, surfaceFormOrdinal])
  @@index([globalObjectId])
  @@map("memory_global_object_surface_memberships")
}

/// Assertion template 中一次 Fragment 引用当前解析到哪个 Global Object。
model MemoryGlobalAssertionReferenceResolution {
  assertionId      String @map("assertion_id") @db.Uuid
  referenceOrdinal Int    @map("reference_ordinal")
  globalObjectId   String @map("global_object_id") @db.Uuid

  sourceReference MemoryAssertionFragmentReference @relation(fields: [assertionId, referenceOrdinal], references: [assertionId, ordinal], onDelete: Cascade)
  globalObject    MemoryGlobalObject               @relation(fields: [globalObjectId], references: [id], onDelete: Restrict)

  @@id([assertionId, referenceOrdinal])
  @@index([globalObjectId])
  @@map("memory_global_assertion_reference_resolutions")
}

/// Assertion 文本中一次已经绑定到 GlobalObject 的直接 reference atom；保留出现顺序与 source template span。
model MemoryGlobalAssertionLiteralReference {
  atomId         String @id @map("atom_id") @db.Text
  assertionId    String @map("assertion_id") @db.Uuid
  literalOrdinal Int    @map("literal_ordinal")
  globalOrdinal  Int    @map("global_ordinal")
  sourceStart    Int    @map("source_start")
  sourceEnd      Int    @map("source_end")
  sourceText     String @map("source_text") @db.Text
  globalObjectId String @map("global_object_id") @db.Uuid

  assertion    MemoryAssertion    @relation(fields: [assertionId], references: [id], onDelete: Cascade)
  globalObject MemoryGlobalObject @relation(fields: [globalObjectId], references: [id], onDelete: Restrict)

  @@unique([assertionId, literalOrdinal])
  @@index([assertionId, globalOrdinal])
  @@index([globalObjectId])
  @@map("memory_global_assertion_literal_references")
}

/// Search 派生的 Assertion 向量索引状态；基础 cold-start importer 不负责写入。
model MemoryAssertionEmbeddingIndex {
  compilationId         String   @id @map("compilation_id") @db.Uuid
  modelKey              String   @map("model_key") @db.Text
  modelRevision         String   @map("model_revision") @db.Text
  dimension             Int
  indexedAssertionCount Int      @map("indexed_assertion_count")
  indexedAt             DateTime @default(now()) @map("indexed_at")

  compilation MemoryCompilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)

  @@map("memory_assertion_embedding_indexes")
}

/// Search 派生的 Assertion BGE-M3 向量；可在基础记忆重新导入后完整重建。
model MemoryAssertionEmbedding {
  assertionId String                      @id @map("assertion_id") @db.Uuid
  contentHash String                      @map("content_hash") @db.Text
  embedding   Unsupported("vector(1024)")
  createdAt   DateTime                    @default(now()) @map("created_at")

  assertion MemoryAssertion @relation(fields: [assertionId], references: [id], onDelete: Cascade)

  @@map("memory_assertion_embeddings")
}

/// 业务 View 中的一张正式 Card。知识投影可锚定 Global Object；原生 Runtime Card 不强制来源身份。
model SemanticCard {
  id             String   @id @default(uuid()) @db.Uuid
  compilationId  String?  @map("compilation_id") @db.Uuid
  sourceObjectId String?  @map("source_object_id") @db.Uuid
  viewKey        String   @map("view_key") @db.Text
  cardTypeKey    String   @map("card_type_key") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  compilation       MemoryCompilation?         @relation(fields: [compilationId], references: [id], onDelete: Restrict)
  sourceObject      MemoryGlobalObject?        @relation(fields: [sourceObjectId], references: [id], onDelete: Restrict)
  contentDimensions SemanticContentDimension[]
  outgoingSlots     SemanticSlotBinding[]      @relation("SemanticSlotSource")
  incomingSlots     SemanticSlotBinding[]      @relation("SemanticSlotTarget")

  @@index([viewKey, cardTypeKey])
  @@index([sourceObjectId])
  @@map("semantic_cards")
}

/// Card 中开放、可由 Chat AI 提议演化的认知内容。
model SemanticContentDimension {
  id              String   @id @default(uuid()) @db.Uuid
  cardId          String   @map("card_id") @db.Uuid
  name            String   @db.Text
  contentMarkdown String   @map("content_markdown") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  card     SemanticCard                      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  supports SemanticContentDimensionSupport[]

  @@unique([cardId, name])
  @@map("semantic_content_dimensions")
}

/// 旧版可选来源关联；正式 ContentDimension 本身不依赖 Assertion 才成立。
model SemanticContentDimensionSupport {
  contentDimensionId String @map("content_dimension_id") @db.Uuid
  assertionId        String @map("assertion_id") @db.Uuid

  contentDimension SemanticContentDimension @relation(fields: [contentDimensionId], references: [id], onDelete: Cascade)
  assertion        MemoryAssertion          @relation(fields: [assertionId], references: [id], onDelete: Restrict)

  @@id([contentDimensionId, assertionId])
  @@index([assertionId])
  @@map("semantic_content_dimension_supports")
}

/// 开发者定义 Slot schema；数据库仅保存当前正式 Card-to-Card binding。
model SemanticSlotBinding {
  sourceCardId String   @map("source_card_id") @db.Uuid
  slotKey      String   @map("slot_key") @db.Text
  targetCardId String   @map("target_card_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sourceCard SemanticCard                 @relation("SemanticSlotSource", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCard SemanticCard                 @relation("SemanticSlotTarget", fields: [targetCardId], references: [id], onDelete: Restrict)
  supports   SemanticSlotBindingSupport[]

  @@id([sourceCardId, slotKey, targetCardId])
  @@index([targetCardId])
  @@map("semantic_slot_bindings")
}

/// 旧版可选来源关联；正式 SlotBinding 本身不依赖 Assertion 才成立。
model SemanticSlotBindingSupport {
  sourceCardId String @map("source_card_id") @db.Uuid
  slotKey      String @map("slot_key") @db.Text
  targetCardId String @map("target_card_id") @db.Uuid
  assertionId  String @map("assertion_id") @db.Uuid

  binding   SemanticSlotBinding @relation(fields: [sourceCardId, slotKey, targetCardId], references: [sourceCardId, slotKey, targetCardId], onDelete: Cascade)
  assertion MemoryAssertion     @relation(fields: [assertionId], references: [id], onDelete: Restrict)

  @@id([sourceCardId, slotKey, targetCardId, assertionId])
  @@index([assertionId])
  @@map("semantic_slot_binding_supports")
}

/// Chat 中等待用户明确批准或拒绝的最薄 Proposal 持久化。
model SemanticCardProposal {
  id            String                     @id @default(uuid()) @db.Uuid
  compilationId String                     @map("compilation_id") @db.Uuid
  viewKey       String                     @map("view_key") @db.Text
  status        SemanticCardProposalStatus @default(pending)
  reason        String                     @db.Text
  payload       Json                       @db.JsonB
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime?                  @map("decided_at") @db.Timestamptz(3)
  appliedAt     DateTime?                  @map("applied_at") @db.Timestamptz(3)
  failureReason String?                    @map("failure_reason") @db.Text

  compilation MemoryCompilation @relation(fields: [compilationId], references: [id], onDelete: Restrict)

  @@index([viewKey, status, createdAt])
  @@map("semantic_card_proposals")
}

/// 对 GlobalObject 身份的可审计修改建议；批准前不改变名称、归属或 Assertion 引用。
model MemoryObjectChangeProposal {
  id            String                     @id @default(uuid()) @db.Uuid
  compilationId String                     @map("compilation_id") @db.Uuid
  status        SemanticCardProposalStatus @default(pending)
  reason        String                     @db.Text
  payload       Json                       @db.JsonB
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedAt     DateTime?                  @map("decided_at") @db.Timestamptz(3)
  appliedAt     DateTime?                  @map("applied_at") @db.Timestamptz(3)
  failureReason String?                    @map("failure_reason") @db.Text

  compilation MemoryCompilation @relation(fields: [compilationId], references: [id], onDelete: Cascade)

  @@index([compilationId, status, createdAt])
  @@map("memory_object_change_proposals")
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum GuidelineKind {
  workflow
  rule
  checklist
  experience
}

enum GuidelineStatus {
  draft
  published
}

enum GuidelineRelationType {
  contains
  triggers
  requires
  next
  exception
}

enum OrganizationTermPhase {
  planned
  active
  closing
}

enum ProjectPhase {
  draft
  planning
  preparation
  active
  closing
  completed
  cancelled
}

/// 跨届期存在的运营成员；不包含普通参赛者、训练参与者或群成员。
model Member {
  /// 系统内部身份，不使用学号等外部标识。
  id String @id @default(uuid()) @db.Uuid

  /// 成员姓名允许重名，由 id 区分具体人员。
  name String @db.Text

  /// 入学年份允许未知；不保存会随时间变化的年级描述。
  enrollmentYear Int? @map("enrollment_year") @db.SmallInt

  /// 停止参与社团运营的自然日；为空表示仍在参与。
  leftOn DateTime? @map("left_on") @db.Date

  /// 创建时间即成员加入本系统的时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  presidentOfTerms OrganizationTerm[] @relation("OrganizationTermPresident")
  ownedProjects    Project[]          @relation("ProjectOwner")
  assignedTasks    Task[]             @relation("TaskAssignee")

  @@map("members")
}

/// 由实际换届划分的责任周期；全库至多一个届期处于 active。
model OrganizationTerm {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique(map: "organization_terms_name_key") @db.Text

  /// 实际开始承担责任的自然日，不保存预计日期。
  startsOn DateTime? @map("starts_on") @db.Date

  /// 实际完成换届交接的责任边界自然日。
  endsOn DateTime? @map("ends_on") @db.Date

  phase OrganizationTermPhase @default(planned)

  /// planned 届期可以暂时没有会长；active 和 closing 必须有会长。
  presidentMemberId String? @map("president_member_id") @db.Uuid
  president         Member? @relation("OrganizationTermPresident", fields: [presidentMemberId], references: [id], onDelete: Restrict)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  projects Project[]

  @@index([phase, archivedAt])
  @@index([presidentMemberId])
  @@map("organization_terms")
}

/// 属于一个届期的完整事项；标题与人工确认摘要共同表达项目目标和范围。
model Project {
  id String @id @default(uuid()) @db.Uuid

  organizationTermId String       @map("organization_term_id") @db.Uuid
  title              String       @db.Text
  summary            String?      @db.Text
  phase              ProjectPhase @default(draft)

  /// draft 阶段可以暂时没有负责人，其他阶段必须保留负责人。
  ownerMemberId String? @map("owner_member_id") @db.Uuid

  plannedStartOn DateTime? @map("planned_start_on") @db.Date
  plannedEndOn   DateTime? @map("planned_end_on") @db.Date
  actualStartOn  DateTime? @map("actual_start_on") @db.Date
  actualEndOn    DateTime? @map("actual_end_on") @db.Date
  completedOn    DateTime? @map("completed_on") @db.Date
  cancelledOn    DateTime? @map("cancelled_on") @db.Date

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizationTerm OrganizationTerm @relation(fields: [organizationTermId], references: [id], onDelete: Restrict)
  owner            Member?          @relation("ProjectOwner", fields: [ownerMemberId], references: [id], onDelete: Restrict)
  tasks            Task[]

  @@index([organizationTermId, phase])
  @@index([ownerMemberId])
  @@map("projects")
}

/// 实现项目目标的具体行动；完成、取消和逾期状态由日期字段派生。
model Task {
  id String @id @default(uuid()) @db.Uuid

  projectId String @map("project_id") @db.Uuid
  title     String @db.Text

  assigneeMemberId   String? @map("assignee_member_id") @db.Uuid
  description        String? @db.Text
  acceptanceCriteria String? @map("acceptance_criteria") @db.Text
  currentProgress    String? @map("current_progress") @db.Text

  dueOn       DateTime? @map("due_on") @db.Date
  completedOn DateTime? @map("completed_on") @db.Date
  cancelledOn DateTime? @map("cancelled_on") @db.Date

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee Member? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([assigneeMemberId])
  @@map("tasks")
}

/// 指导层的最小单元。一行代表当前可用的一条工作流、规则、检查表或经验。
model Guideline {
  /// 稳定的内部标识；标题修改不会破坏 Guideline 之间的关系。
  id String @id @default(uuid()) @db.Uuid

  /// 面向维护者和用户展示的指导标题。
  title String @db.Text

  /// 指导的表现形式：工作流、规则、检查表或经验。
  kind GuidelineKind

  /// 给人阅读的完整说明，可使用 Markdown 描述背景、步骤和注意事项。
  contentMarkdown String @default("") @map("content_markdown") @db.Text

  /// 是否必须遵守；紧急程度由活动状态动态计算，不在这里固定分级。
  isMandatory Boolean @default(false) @map("is_mandatory")

  /// 结构化触发条件；为空表示由上层工作流或人工选择加载。
  appliesWhen Json? @map("applies_when_jsonb") @db.JsonB

  /// 命中指导后可建议的动作数组，不会直接修改活动状态。
  suggestedActions Json @default("[]") @map("suggested_actions_jsonb") @db.JsonB

  /// 可选形成依据摘要；首版不强制精确回链文件。
  basisNote String? @map("basis_note") @db.Text

  /// draft 不参与运行时指导；published 可被指导解析器读取。
  status GuidelineStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outgoingLinks GuidelineLink[] @relation("GuidelineLinkFrom")
  incomingLinks GuidelineLink[] @relation("GuidelineLinkTo")

  @@index([status])
  @@index([kind])
  @@map("guidelines")
}

/// 指导节点之间的有向连线，用于表达工作流结构、触发、前置和例外路径。
model GuidelineLink {
  /// 连线起点：当前 Guideline。
  fromGuidelineId String @map("from_guideline_id") @db.Uuid

  /// 连线终点：被包含、触发、要求、衔接或作为例外处理的 Guideline。
  toGuidelineId String @map("to_guideline_id") @db.Uuid

  /// contains、triggers、requires、next 或 exception。
  relationType GuidelineRelationType @map("relation_type")

  /// 可选维护备注，不作为规则判断条件。
  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  fromGuideline Guideline @relation("GuidelineLinkFrom", fields: [fromGuidelineId], references: [id], onDelete: Cascade)
  toGuideline   Guideline @relation("GuidelineLinkTo", fields: [toGuidelineId], references: [id], onDelete: Cascade)

  @@id([fromGuidelineId, toGuidelineId, relationType])
  @@index([toGuidelineId, relationType])
  @@map("guideline_links")
}

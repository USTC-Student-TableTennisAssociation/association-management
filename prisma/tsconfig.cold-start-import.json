{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "../.prisma-cold-start-build",
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "./import-cold-start.ts",
    "../src/generated/prisma/**/*.ts"
  ]
}

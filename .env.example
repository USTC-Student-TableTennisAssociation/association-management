AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Chat API 的模型上下文预算。第一版使用保守 token 估算，不是厂商 tokenizer 精确值。
AI_CONTEXT_WINDOW_TOKENS=200000
AI_PREFERRED_INPUT_TOKENS=128000
AI_MAX_OUTPUT_TOKENS=16384
AI_CONTEXT_SAFETY_TOKENS=12000
AI_HISTORY_MAX_TOKENS=40000
AI_MEMORY_MAX_TOKENS=64000
# 包含最多 4 个 tool-loop 模型 step 的整轮总时限。
AI_TIMEOUT_SECONDS=480
# 浏览器当前仍会随每轮请求提交完整 UI 历史；超限时返回 413，不静默截断。
AI_MAX_REQUEST_BYTES=2000000
# Object–Assertion 第一版直接检索 PostgreSQL；fixture/disabled 仅用于测试和排障。
MEMORY_RETRIEVER_MODE=object-assertion
# 常驻 BGE-M3 服务；查询模型/修订必须与当前单一 Compilation 一致。
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8765
# `memory:index-assertions` 的简单批处理参数；索引只在 Global Resolution 导入完成后手动运行。
MEMORY_EMBEDDING_BATCH_SIZE=64
MEMORY_EMBEDDING_TIMEOUT_MS=120000
# true 时向量服务不可用就明确失败，不静默伪装成完整混合检索。
MEMORY_VECTOR_REQUIRED=true
# 首版相关性门槛；避免纯向量 Top-K 让任意问题都看起来“有答案”。
MEMORY_MIN_LEXICAL_SCORE=0.18
MEMORY_MIN_VECTOR_SCORE=0.35
# 整个冷启动进程共享的模型请求速率。学校接口 RPM=20 时建议保留余量设置为 18。
AI_REQUESTS_PER_MINUTE=18

# PDF 由 MinerU 解析。当前手册验证效果最好的组合是 hybrid-engine + high + 图片分析。
COLD_START_MINERU_BACKEND=hybrid-engine
COLD_START_MINERU_EFFORT=high
COLD_START_MINERU_METHOD=auto
COLD_START_MINERU_IMAGE_ANALYSIS=true

# 冷启动模块的本地向量模型。生产环境建议改为服务器上的 BGE-M3 绝对路径。
COLD_START_EMBEDDING_MODEL=BAAI/bge-m3
COLD_START_EMBEDDING_MODEL_REVISION=huggingface-main
# 留空时依次自动选择 cuda、mps、cpu；也可显式填写其中一个。
COLD_START_EMBEDDING_DEVICE=
COLD_START_EMBEDDING_BATCH_SIZE=8
# 同时判断的区域数量；文档背景线路独立运行，因此实际模型请求峰值可能再多 1 个。
COLD_START_MAX_PARALLEL_REGIONS=6
# 同时进行完整基础提取和覆盖复核的 content_source 节点数量。
COLD_START_MAX_PARALLEL_COMPILATIONS=6
# 同一树深度内同时进行的父节点整合数量。
COLD_START_MAX_PARALLEL_PARENT_INTEGRATIONS=3
# 同时处理多少个父级语义分组。
COLD_START_MAX_PARALLEL_PERSPECTIVE_GROUPS=6
# 单次对象语义校正和局部投影最多处理多少项。四线路全局复核读取完整紧凑图。
COLD_START_PERSPECTIVE_OBJECTS_PER_GROUP=40
# 对象分类分组展开为紧凑 Assertion 后允许的最大字符数。
COLD_START_PERSPECTIVE_OBJECT_GROUP_CHARS=50000
COLD_START_PERSPECTIVE_ASSERTIONS_PER_GROUP=12
# 父节点关系恢复—四线路复核—定向修复的最大循环轮数；状态稳定时会提前结束。
COLD_START_PERSPECTIVE_MAX_REVIEW_ROUNDS=5
# `pnpm prisma:dev` 创建的本机开发数据库连接。
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/template1
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:51215/template1

AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# 冷启动模块的本地向量模型。生产环境建议改为服务器上的 BGE-M3 绝对路径。
COLD_START_EMBEDDING_MODEL=BAAI/bge-m3
# 留空时依次自动选择 cuda、mps、cpu；也可显式填写其中一个。
COLD_START_EMBEDDING_DEVICE=
COLD_START_EMBEDDING_BATCH_SIZE=8
# 同时判断的区域数量；文档背景线路独立运行，因此实际模型请求峰值可能再多 1 个。
COLD_START_MAX_PARALLEL_REGIONS=6
# 同时编译的内容叶子数量；学校接口较慢时可按实际并发能力调整。
COLD_START_MAX_PARALLEL_COMPILATIONS=6
# 同一树深度同时整合的父节点数量。
COLD_START_MAX_PARALLEL_PARENT_INTEGRATIONS=6

# `pnpm prisma:dev` 创建的本机开发数据库连接。
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/template1
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:51215/template1

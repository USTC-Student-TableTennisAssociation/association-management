AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# 资料库图片先由独立视觉模型转成 OCR/场景观察，再把文字交给 AI_MODEL 编译。
# 视觉模型可与普通模型共用 API；若来自不同服务，再填写下面两个覆盖项。
AI_VISION_MODEL=
AI_VISION_API_KEY=
AI_VISION_API_BASE_URL=
AI_VISION_REQUESTS_PER_MINUTE=10
# 已发出且仍在 thinking / 流式输出的最大请求数。
AI_TEXT_MAX_IN_FLIGHT=18
AI_VISION_MAX_IN_FLIGHT=18
# 粗编译文件级并发；所有文字模型请求仍由 AI_REQUESTS_PER_MINUTE 统一错峰。
LIBRARY_COARSE_CONCURRENCY=18
# 仅归档语义编目的文件级并发；与粗编译共用文字模型限速器。
LIBRARY_CATALOG_CONCURRENCY=18
# 生产 Chat Actor 来自登录 Session。下列固定 Actor 只供离线/真实模型记忆测试使用。
SYDARIS_ACTOR_ID=00000000-0000-4000-8000-000000000001
SYDARIS_ACTOR_DISPLAY_NAME=开发用户
ENVIRONMENT_TIMEZONE=Asia/Shanghai
# 开发阶段默认开启：每轮聊天生成一份本地、无索引的 Markdown 调试报告。
SYDARIS_DEBUG_TRACE=true
# 留空时写入项目根目录下的 .sydaris-debug/chat-runs。
SYDARIS_DEBUG_TRACE_DIR=
# Chat API 的模型上下文预算。第一版使用保守 token 估算，不是厂商 tokenizer 精确值。
AI_CONTEXT_WINDOW_TOKENS=200000
AI_PREFERRED_INPUT_TOKENS=128000
AI_MAX_OUTPUT_TOKENS=16384
# 仅重试尚未建立输出流的可恢复模型请求；不会重放已经执行过工具的整轮对话。
AI_MAX_RETRIES=2
# 首块和相邻语义块长期无输出时中止；持续产生 reasoning/content 不会触发。
AI_MODEL_FIRST_CHUNK_TIMEOUT_MS=1800000
AI_MODEL_CHUNK_TIMEOUT_MS=1800000
AI_CONTEXT_SAFETY_TOKENS=12000
AI_HISTORY_MAX_TOKENS=40000
AI_MEMORY_MAX_TOKENS=64000
# 模型流连续 30 分钟无输出才中止；部署层另保留 60 分钟整轮上限。
# 浏览器提交最终回答、轻量引用与 Proposal 历史；不重复发送既往工具正文。超限时返回 413，不静默截断。
AI_MAX_REQUEST_BYTES=2000000
# Object–Assertion 第一版直接检索 PostgreSQL；fixture/disabled 仅用于测试和排障。
MEMORY_RETRIEVER_MODE=object-assertion
# 常驻 BGE-M3 服务；查询模型/修订必须与当前单一 Compilation 一致。
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:8765
# `memory:index-assertions` 的简单批处理参数；索引只在 Global Resolution 导入完成后手动运行。
MEMORY_EMBEDDING_BATCH_SIZE=64
MEMORY_EMBEDDING_TIMEOUT_MS=120000
# true 时向量服务不可用就明确失败，不静默伪装成完整混合检索。
MEMORY_VECTOR_REQUIRED=true
# 首版相关性门槛；避免纯向量 Top-K 让任意问题都看起来“有答案”。
MEMORY_MIN_LEXICAL_SCORE=0.18
MEMORY_MIN_VECTOR_SCORE=0.35
# 整个冷启动进程共享的模型请求速率。学校接口 RPM=20 时建议保留余量设置为 18。
AI_REQUESTS_PER_MINUTE=18

# 文档由 MinerU 解析。auto 在配置 MINERU_API_BASE_URL 时使用学校 API，否则使用本地 CLI。
COLD_START_MINERU_PROVIDER=auto
# 学校 MinerU 与学校模型服务可以共用 Key；MINERU_API_KEY 留空时回退到 AI_API_KEY。
MINERU_MODEL=mineru
MINERU_API_KEY=
MINERU_API_BASE_URL=
# 默认从 Base URL 的 origin 构造 /mineru/file_parse；仅在服务路径不同时覆盖。
MINERU_API_FILE_PARSE_URL=
# /file_parse 是同步长请求；单个文档默认允许等待 30 分钟。
MINERU_API_TIMEOUT_SECONDS=1800
# 以下解析质量参数只传给本地 MinerU CLI；学校 API 使用服务端默认解析引擎。
COLD_START_MINERU_BACKEND=hybrid-engine
COLD_START_MINERU_EFFORT=medium
COLD_START_MINERU_METHOD=auto
COLD_START_MINERU_IMAGE_ANALYSIS=true

# 冷启动模块的本地向量模型。生产环境建议改为服务器上的 BGE-M3 绝对路径。
COLD_START_EMBEDDING_MODEL=BAAI/bge-m3
COLD_START_EMBEDDING_MODEL_REVISION=huggingface-main
# 留空时依次自动选择 cuda、mps、cpu；也可显式填写其中一个。
COLD_START_EMBEDDING_DEVICE=
COLD_START_EMBEDDING_BATCH_SIZE=8
# 同时判断的区域数量；文档背景线路独立运行，因此实际模型请求峰值可能再多 1 个。
COLD_START_MAX_PARALLEL_REGIONS=18
# 同时进行 Source Semantics 编译的 content_source 节点数量。
COLD_START_MAX_PARALLEL_COMPILATIONS=18
COLD_START_MODEL_MAX_IN_FLIGHT=18
# Library 解析与深度编译产物根目录；留空时使用项目根目录的 .cold-start。
SYDARIS_COLD_START_OUTPUT_ROOT=
# `pnpm prisma:dev` 创建的本机开发数据库连接。
DATABASE_URL=postgresql://postgres:postgres@localhost:51214/template1
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:51215/template1
# USTCTTA-site 比赛源库；只由 internal View/automation Tool 以只读查询使用。
USTCTTA_DATABASE_URL=
# 资料库内容寻址对象存储；留空时使用项目根目录的 .sydaris-library。
SYDARIS_LIBRARY_STORAGE_ROOT=

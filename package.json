{
  "name": "association-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm prisma:generate && pnpm plugins:build && node scripts/echo-plugin.mjs generate",
    "dev": "next dev",
    "prebuild": "pnpm prisma:generate && pnpm plugins:build && node scripts/echo-plugin.mjs generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "pnpm prisma:generate && pnpm plugins:build && node scripts/echo-plugin.mjs generate --check",
    "test": "vitest run --passWithNoTests",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:dev": "prisma dev --name association-management --port 51213 --db-port 51214 --shadow-db-port 51215 --detach",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:snapshot": "zsh scripts/database-snapshot.zsh",
    "db:restore": "zsh scripts/database-restore.zsh",
    "memory:index-assertions": "prisma generate && tsc --project prisma/tsconfig.assertion-index.json && node .prisma-assertion-index-build/prisma/index-assertions.js",
    "memory:serve-embeddings": "uv run --project services/cold-start cold-start serve-embeddings",
    "library:import": "prisma generate && node scripts/import-library.mjs",
    "preecho:plugin": "pnpm --filter @sydaris/plugin-sdk build",
    "echo:plugin": "node scripts/echo-plugin.mjs",
    "plugins:build": "pnpm --filter @sydaris/plugin-sdk build && pnpm --filter echo-activity-operations-plugin build && pnpm --filter echo-society-information-plugin build && pnpm --filter @sydaris/competition-records-plugin build && pnpm --filter @sydaris/example-plugin build",
    "plugins:pack:sdk": "pnpm --filter @sydaris/plugin-sdk pack",
    "plugins:pack:example": "pnpm --filter @sydaris/example-plugin pack",
    "plugins:pack:activity": "pnpm --filter echo-activity-operations-plugin pack",
    "plugins:pack:society": "pnpm --filter echo-society-information-plugin pack",
    "plugins:pack:competition": "pnpm --filter @sydaris/competition-records-plugin pack"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.25",
    "@ai-sdk/react": "^4.0.58",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sydaris/competition-records-plugin": "workspace:*",
    "ai": "^7.0.55",
    "cytoscape": "^3.34.0",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sydaris/plugin-sdk": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

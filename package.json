{
  "name": "association-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:dev": "prisma dev --name association-management --port 51213 --db-port 51214 --shadow-db-port 51215 --detach",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "guidance:validate": "tsc --project prisma/tsconfig.seed.json && node .prisma-seed-build/prisma/validate-handbook-guidance.js",
    "guidance:import": "tsc --project prisma/tsconfig.seed.json && node .prisma-seed-build/prisma/seed-handbook-guidance.js",
    "guidance:verify": "tsc --project prisma/tsconfig.seed.json && node .prisma-seed-build/prisma/verify-handbook-guidance.js",
    "parse": "npx tsx scripts/test-reimbursement-parser.ts",
    "parse:json": "JSON_OUTPUT=1 npx tsx scripts/test-reimbursement-parser.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cytoscape": "^3.34.0",
    "dotenv": "^17.4.2",
    "next": "16.2.10",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

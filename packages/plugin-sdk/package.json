    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/USTC-Student-TableTennisAssociation/association-management.git",
    "directory": "packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/USTC-Student-TableTennisAssociation/association-management/issues"
  },
  "homepage": "https://github.com/USTC-Student-TableTennisAssociation/association-management#readme",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.0.0"
  },
  "license": "Apache-2.0"
}

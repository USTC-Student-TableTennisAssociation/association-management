{
  "name": "@sydaris/plugin-sdk",
  "version": "0.1.0-alpha.3",
  "description": "Public contracts and React helpers for Echo plugins",
  "keywords": [
    "echo",
    "plugin",
    "sdk",
    "view"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/packages/*/dist
/packages/*/node_modules
/src/plugins/*/dist
/src/plugins/*/node_modules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.sydaris-debug
/.sydaris-snapshots
/.playwright-cli

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client is generated from prisma/schema.prisma.
/src/generated/prisma
/.prisma-cold-start-build
/.prisma-basic-memory-build
/.prisma-assertion-index-build

# Python cold-start worker
/services/cold-start/.venv
/services/cold-start/.pytest_cache
/services/cold-start/.ruff_cache
/services/cold-start/**/__pycache__
/services/cold-start/**/*.py[cod]
/services/mineru-parser/.venv
/services/mineru-parser/.pytest_cache
/services/mineru-parser/.ruff_cache
/services/mineru-parser/**/__pycache__
/services/mineru-parser/**/*.py[cod]
/.cold-start
/.sydaris-library

# Local Syncthing configuration
.stignore
.syncignore
.stfolder

.agents
output
